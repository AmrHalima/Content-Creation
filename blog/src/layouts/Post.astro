---
import Base from "./Base.astro";
import { site } from "../config";
import type { PostLang } from "../content.config";
import { postPath, otherLang, indexPath } from "../content.config";

interface Props {
  lang: PostLang;
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  hero?: string;
  heroAlt?: string;
  tags?: string[];
  /** true when a translation with the same id exists in the other collection */
  hasTranslation: boolean;
  imageAlt?: string;
}

const { lang, id, title, description, pubDate, hero, tags = [], hasTranslation, imageAlt } = Astro.props;
const path = postPath(lang, id);
const alt = otherLang(lang);
const origin = Astro.site?.origin.replace(/\/$/, "") ?? "";
const dateLabel = pubDate.toLocaleDateString(lang === "ar" ? "ar-EG" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = {
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  inLanguage: lang === "ar" ? "ar" : "en",
  ...(hero ? { image: origin + hero } : {}),
  ...(tags.length ? { keywords: tags.join(", ") } : {}),
  author: { "@type": "Organization", name: lang === "ar" ? site.titleAr : site.title },
  publisher: { "@type": "Organization", name: lang === "ar" ? site.titleAr : site.title },
  mainEntityOfPage: origin + path,
};

const alternates = hasTranslation ? [{ lang: alt, href: postPath(alt, id) }] : [];
---

<Base lang={lang} title={title} description={description} path={path} image={hero} alternates={alternates} jsonLd={jsonLd}>
  <article>
    <header class="post-head">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{dateLabel}</time>
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>
    {hero && (
      <>
        <img class="hero" src={hero} alt={imageAlt ?? title} width="1200" height="630" fetchpriority="high" />
      </>
    )}
    <div class="prose">
      <slot />
    </div>
    <p style="margin-block-start:3rem;">
      <a href={indexPath(lang)}>← {lang === "ar" ? "كل المقالات" : "All posts"}</a>
    </p>
  </article>
</Base>
