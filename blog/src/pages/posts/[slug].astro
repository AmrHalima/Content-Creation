---
import { getCollection, render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { collectionFor, otherLang } from "../../content.config";

export async function getStaticPaths() {
  const posts = await getCollection("posts-en", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const translations = await getCollection(collectionFor(otherLang("en")));
const hasTranslation = translations.some((t) => t.id === post.id);
const { Content } = await render(post);
---

<Post
  lang="en"
  id={post.id}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  hero={post.data.hero}
  tags={post.data.tags}
  hasTranslation={hasTranslation}
>
  <Content />
</Post>
